#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        label = "Default";
        physical-layout = <&physical_layout0>;

        default_layer { // Layer 0
            bindings = <
                &kp N6          &kp N7      &kp N8         &kp N9   &kp N0
                &kp Y           &kp U       &kp I          &kp O    &kp SEMI
                &kp H           &kp J       &kp K          &kp L    &kp P
                &kp N           &kp M       &kp COMMA      &kp DOT  &kp SLASH
                &rgb_ug RGB_TOG &kp SPACE   &kp BACKSPACE  &studio_unlock
            >;
        };
    };
 };